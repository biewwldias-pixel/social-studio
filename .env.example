# Chave da IA (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Ponte temporária de imagem (Cloudflare R2 - plano gratuito)
# As imagens são enviadas só durante a publicação na Meta e apagadas logo depois
R2_CLOUDFLARE_ENDPOINT_DEFAULT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_CLOUDFLARE_PUBLIC_URL=https://pub-<HASH>.r2.dev
R2_CLOUDFLARE_ACCESS_KEY_ID=
R2_CLOUDFLARE_SECRET_ACCESS_KEY=
R2_BUCKET=social-studio-media
